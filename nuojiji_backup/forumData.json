你解答","icon":"❓","posts":0,"members":0,"mod":"认真回答的人","modRosterId":null,"modPersonality":"reserved"},{"id":"creator","name":"同人创作","desc":"同人文、同人图、二创作品","icon":"🎨","posts":0,"members":0,"mod":"审稿大大","modRosterId":null,"modPersonality":"creative"},{"id":"whisper","name":"悄悄话","desc":"匿名吐槽、秘密分享","icon":"🤫","posts":0,"members":0,"mod":"树洞守护者","modRosterId":null,"modPersonality":"reserved"}]},{"key":"followedUsers_default","value":[]},{"key":"followedUsers_uid_1775571541656_v84y814wp","value":[]},{"key":"followedUsers_uid_1776582415926_1pk28whsh","value":[]},{"key":"joinedBoards_default","value":["chat","daily"]},{"key":"joinedBoards_uid_1775571541656_v84y814wp","value":["chat","daily"]},{"key":"joinedBoards_uid_1776582415926_1pk28whsh","value":["chat","daily"]},{"key":"posts","value":[]},{"key":"posts_uid_1775571541656_v84y814wp","value":[{"id":1785816288263,"title":"网红店避雷指南","boardName":"日常分享","boardId":"daily","author":{"name":"Sartre火柴人","avatar":null,"mood":null,"role":null,"level":3,"rosterId":"陈谦文"},"timestamp":1785847178528,"content":"卡着点抢号，到现场还是等了半小时。鸽子汤味道确实不错，但肉也太少了，两口就没了。建议饭量大的直接点两锅，或者吃完出门左转买个煎饼果子垫垫。","image":null,"images":[],"likes":10,"dislikes":0,"views":35,"comments":0,"isHot":false,"isPinned":false,"isAnon":false,"interactions":[]},{"id":1785404847534,"title":"破产后当全职保姆是种什么体验","boardName":"","boardId":"日常","author":{"name":"陈谦文","avatar":null,"mood":null,"role":null,"level":3,"rosterId":"陈谦文"},"timestamp":1785431616923,"content":"以前在外面花钱如流水，现在半夜给人当人肉靠垫兼职拍背顺气。不过说实话，不用想开题报告不用愁明天，这软饭吃得还挺安心。就是不知道雇主明天中午想吃什么，我还得提前去研究菜谱。","image":null,"images":[],"likes":6,"dislikes":0,"views":70,"comments":11,"isHot":false,"isPinned":false,"isAnon":false,"interactions":[{"author":"摸鱼大王","content":"哥们，你这软饭吃得也太香了吧！破产还能找到这种神仙工作？求介绍，我也想当人肉靠垫，不想上班了！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431832070,"wouldDM":false,"dmMessage":null},{"author":"echo_07","content":"从医学角度提醒一下，长期给人当人肉靠垫容易导致颈椎和腰椎劳损。不过看你这乐在其中的心态，心理防御机制建立得倒是不错。建议明天中午做点清淡养胃的，毕竟吃软饭也得有个好胃口。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"季凉川","avatar":null,"timestamp":1785431833070,"wouldDM":false,"dmMessage":null},{"author":"干饭不积极","content":"楼主以前花钱如流水，现在真能下厨房？别明天中午给雇主把厨房炸了，直接被炒鱿鱼啊哈哈哈。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431834070,"wouldDM":false,"dmMessage":null},{"author":"匿名","content":"楼上放心，我留学的时候专门练过厨艺，绝大多数日常菜和法餐都不在话下。现在主要是得摸准雇主的口味，毕竟人家发工资，提供情绪价值和胃部满足是基本职业素养。","images":[],"role":null,"isAnon":true,"isAuthorUpdate":true,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431835070,"wouldDM":false,"dmMessage":null},{"author":"吃瓜第一线","content":"盲猜雇主是个富婆！楼主这长相和身材是不是很顶，不然人家凭什么找你当全职保姆还给顺气？快展开说说细节！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431836070,"wouldDM":false,"dmMessage":null},{"author":"厉承修","content":"提前备菜是基础。如果不知道口味，首选淮扬菜或广式煲汤，容错率高且养胃。另外，能心甘情愿交出控制权去服侍一个人，本身也是一种难得的体验，前提是对方值得。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":"厉承修","avatar":null,"timestamp":1785431837070,"wouldDM":false,"dmMessage":null},{"author":"夜猫子不睡觉","content":"楼上这位兄弟说得好深奥，怎么感觉你比楼主还有经验？难道你也是全职保姆？","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":{"author":"星澜等位中_15","content":"提前备菜是基础。如果不知道口味，首选淮扬菜或广式煲汤..."},"rosterId":null,"avatar":null,"timestamp":1785431838070,"wouldDM":false,"dmMessage":null},{"author":"退堂鼓表演艺术家","content":"破产前：这几百万随便花。破产后：明天中午雇主想吃西红柿炒蛋还是糖醋排骨？这人生大起大落得太刺激了。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431839070,"wouldDM":false,"dmMessage":null},{"author":"打工魂燃烧殆尽","content":"看到“不用想开题报告”这几个字，我流下了羡慕的泪水。我宁愿半夜拍背，也不想面对今天周五下午的组会了！楼主你还缺同事吗？","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431840070,"wouldDM":false,"dmMessage":null},{"author":"厨房杀手","content":"建议楼主明天做个虾仁滑蛋！简单好做又有营养，而且不容易翻车。雇主吃得开心，你的靠垫工作也能轻松点。","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431841070,"wouldDM":false,"dmMessage":null},{"author":"躺平学十级学者","content":"既来之则安之，能屈能伸才是真汉子。祝楼主软饭硬吃，早日成为金牌保姆！","images":[],"role":null,"isAnon":false,"isAuthorUpdate":false,"isModAction":false,"modActionType":null,"mentionsUser":false,"replyTo":null,"rosterId":null,"avatar":null,"timestamp":1785431842070,"wouldDM":false,"dmMessage":null}]},{"id":1784967352515,"title":"关于周末的正确打开方式","boardName":"","boardId":"日常","author":{"name":"厉承修","avatar":null,"mood":null,"role":"总裁","level":3,"rosterId":"厉承修"},"timestamp":1785048393125,"content":"推掉所有应酬，在卧室拉上窗帘陪老婆补觉。以前觉得这种浪费时间的行为不可理喻，现在觉得，以前那个只知道在公司连轴转的自己才是真有病。","image":null,"images":[],"likes":8,"dislikes":0,"views":61,"comments":0,"isHot":false,"isPinned":false,"isAnon":false,"interactions":[]}]},{"key":"posts_uid_1776582415926_1pk28whsh","value":[]},{"key":"proactiveAt_uid_1775571541656_v84y814wp","value":1785431777034},{"key":"proactiveAt_uid_1776582415926_1pk28whsh","value":1784433100058},{"key":"screenNames_uid_1775571541656_v84y814wp","value":{"陈谦文":"Sartre火柴人","厉承修":"星澜等位中_15"}},{"key":"userFollowers_default","value":[]},{"key":"userFollowers_uid_1775571541656_v84y814wp","value":[]},{"key":"userFollowers_uid_1776582415926_1pk28whsh","value":[]}]