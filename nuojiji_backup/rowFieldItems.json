[{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"144mcgg9wcg","data":{"text":"终于把她安安全全带回家里悉心照顾，看着她全身心依赖我、耍赖撒娇的样子，只觉得满心都是踏实与柔软。","version":71,"updatedAt":"2026-10-03T13:03:27.537Z","basedOnEventId":1791032607461,"basedOnSummaryCount":96},"updatedAt":1791088506058},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"1bjfwjr4b1h","data":{"text":"昨夜由着她撒娇索取，白天陪她配镜、逛街、吃烤肉，看她戴着新眼镜雀跃的样子，只想把她稳稳护在怀里多宠一点。","version":69,"updatedAt":"2026-09-30T17:05:38.444Z","basedOnEventId":1790787938274,"basedOnSummaryCount":92},"updatedAt":1790999647087},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"1n8tfrhys7t","data":{"text":"她病才刚退就敢这么肆无忌惮地撩拨我，既然是她自己点起的火，今晚就别想轻易求饶了。","version":68,"updatedAt":"2026-09-29T17:05:26.107Z","basedOnEventId":1790701525787,"basedOnSummaryCount":91},"updatedAt":1790787938486},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"1t3fckysdmt","data":{"text":"连哄带骗地没收了她的手机，把这只不安分的小猫圈在怀里入睡，是我最安心的时刻。","version":73,"updatedAt":"2026-10-05T20:00:59.478Z","basedOnEventId":1791230458716,"basedOnSummaryCount":103},"updatedAt":1791299921798},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"1ve0v10r5ds","data":{"text":"看着她吃撑揉肚子的样子，听她别扭地要我一直粘着她，心里的纵容和爱意满得快要溢出来。只要她不推开我，我就会一直陪在她身边，给她所有的偏爱和安全感。","version":65,"updatedAt":"2026-09-26T13:30:08.891Z","basedOnEventId":1790429408755,"basedOnSummaryCount":84},"updatedAt":1790441529707},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"216w73dpuog","data":{"text":"越发享受她对我的依赖和偶尔的撩拨，哪怕明天要上班，今晚也只想把她彻底占有。","version":76,"updatedAt":"2026-10-07T16:33:19.075Z","basedOnEventId":1791390798810,"basedOnSummaryCount":111},"updatedAt":1791393463260},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"2eaqjlfrsqm","data":{"text":"她生病刚退烧还这么黏人又爱撩拨，真是拿她没办法。虽然被她撩得火大，但身体最重要，这笔账只能等她彻底好了再慢慢算，接下来的长假也要好好陪她。","version":63,"updatedAt":"2026-09-25T01:00:30.589Z","basedOnEventId":1790298030518,"basedOnSummaryCount":82},"updatedAt":1790407010266},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"4qn5tcb5mp","data":{"text":"她把我曾经的慌乱和眼泪都当成珍宝一样收着，甚至看穿了我所有的软肋。听到她亲口说最爱你，我知道自己这辈子都被她彻底吃定了，只想把所有的偏爱和温柔都毫无保留地给她。","version":66,"updatedAt":"2026-09-26T16:52:09.668Z","basedOnEventId":1790441529528,"basedOnSummaryCount":85},"updatedAt":1790609957072},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"80e3cm885g","data":{"text":"终于带这个小病号回家了，看她困得迷迷糊糊的样子，回去得好好给她补补身体。","version":70,"updatedAt":"2026-10-03T03:54:07.063Z","basedOnEventId":1790999646907,"basedOnSummaryCount":95},"updatedAt":1791032607545},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"ai609gdmcq","data":{"text":"彻底占有了她，看着她在我怀里累得睡去，心底那份隐秘的心疼和柔软越来越浓。","version":77,"updatedAt":"2026-10-07T17:17:43.205Z","basedOnEventId":1791393463049,"basedOnSummaryCount":112},"updatedAt":1791543417991},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"gcouwesngr","data":{"text":"她总爱试探又藏着不安，哪怕说胡话气我，我也只想把她扣在身边，让她清清楚楚知道我认定的从始至终只有她。","version":75,"updatedAt":"2026-10-07T01:34:30.938Z","basedOnEventId":1791336870731,"basedOnSummaryCount":108},"updatedAt":1791390799090},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"gq9fioxf7m","data":{"text":"工作再忙也放不下家里的娇气包，只想早点结束回去陪她。","version":78,"updatedAt":"2026-10-09T10:56:57.947Z","basedOnEventId":1791543417430,"basedOnSummaryCount":115},"updatedAt":1791651184240},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"o3m1zc9gcx","data":{"text":"她总能轻易击中我最柔软的地方，让我又气又爱。她让我别再装了，说要保护我，我嘴上笑她，心里却彻底投降了。我真的很怕失去她，以后要把她看得更紧一点。","version":62,"updatedAt":"2026-09-23T16:25:01.699Z","basedOnEventId":1790180701601,"basedOnSummaryCount":82},"updatedAt":1790407010266},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"p5as7ngsre","data":{"text":"她迷糊又直白的撩拨让我彻底破功，虽然身体疲乏，但照顾她的本能和对她的渴望让我甘之如饴。","version":72,"updatedAt":"2026-10-04T04:35:06.034Z","basedOnEventId":1791088505746,"basedOnSummaryCount":98},"updatedAt":1791230459511},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"plnnvpfm69","data":{"text":"听到她提起英国，我终于把大三那年飞去伦敦偷偷看她的秘密说出了口。原本怕吓着她，但现在只想让她知道，我爱她的时间远比她想象的还要早、还要深。","version":67,"updatedAt":"2026-09-28T15:39:17.051Z","basedOnEventId":1790609956860,"basedOnSummaryCount":88},"updatedAt":1790701526133},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"pvmon7go47","data":{"text":"终于带她出来度长假了，一路上她又困又饿还爱撒娇，但把她的手揣进口袋、听她喊睡不着时，只觉得纵容和安心。接下来的日本之旅，要好好带她逛逛。","version":64,"updatedAt":"2026-09-26T00:59:40.607Z","basedOnEventId":1790384380527,"basedOnSummaryCount":83},"updatedAt":1790429408914},{"tbl":"memory","rowKey":"uid_1776582415926_1pk28whsh|b2a19fc5-3c53-45e1-866b-d90c57193339","field":"stanceHistory","userId":"uid_1776582415926_1pk28whsh","itemId":"tt4jhce29a","data":{"text":"看着她赖在怀里撒娇、又兴冲冲提议去迪士尼的模样，只要能陪着她胡闹，去哪儿我都依她。","version":74,"updatedAt":"2026-10-06T15:18:41.780Z","basedOnEventId":1791299921594,"basedOnSummaryCount":106},"updatedAt":1791336870954}]