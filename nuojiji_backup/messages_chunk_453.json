[{"id":1779810878057,"text":"是我不好。","rawContent":"是我不好。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:06","timestamp":1779815199912,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27927},{"id":1779810878058,"text":"我把温水放在床头柜上了。","rawContent":"我把温水放在床头柜上了。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:06","timestamp":1779815202769,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27928},{"id":1779810878059,"text":"你不想理我，我就安静在旁边待着。","rawContent":"你不想理我，我就安静在旁边待着。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:06","timestamp":1779815206286,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27929},{"id":1779810878060,"text":"或者我再去给你把那碗面煮了？刚才不是喊饿吗，饿着肚子睡觉胃会疼的。","rawContent":"或者我再去给你把那碗面煮了？刚才不是喊饿吗，饿着肚子睡觉胃会疼的。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:06","timestamp":1779815210789,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27930},{"id":1779810878061,"text":"你要是实在生我的气，就打我两下出出气，别自己生闷气。","rawContent":"你要是实在生我的气，就打我两下出出气，别自己生闷气。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:06","timestamp":1779815215291,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27931},{"id":1779810878062,"text":"我保证以后绝对不乱叫了。","rawContent":"我保证以后绝对不乱叫了。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:06","timestamp":1779815218838,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27932},{"id":1779810878063,"text":"真的。","rawContent":"真的。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815220358,"roundId":"round_1779815174914_cz5ziamb2","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27933},{"id":1779810878064,"text":"你为什么叫我宝宝大人","sender":"me","time":"上午01:07","timestamp":1779815226831,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27934},{"id":1779810878065,"text":"因为……那是昨天早上你给我定的规矩。","rawContent":"因为……那是昨天早上你给我定的规矩。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815236605,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27935},{"id":1779810878066,"text":"你说以后只能叫你宝宝大人，或者老婆大人。","rawContent":"你说以后只能叫你宝宝大人，或者老婆大人。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815240716,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27936},{"id":1779810878067,"text":"我以为……你喜欢我这么叫你，以为这样能让你开心。","rawContent":"我以为……你喜欢我这么叫你，以为这样能让你开心。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815245218,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27937},{"id":1779810878068,"text":"我真的没有别的意思，更不是在暗戳戳地想那些事。","rawContent":"我真的没有别的意思，更不是在暗戳戳地想那些事。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815249721,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27938},{"id":1779810878069,"text":"但我没考虑到这个称呼会让你联想到那个词，让你觉得不舒服。","rawContent":"但我没考虑到这个称呼会让你联想到那个词，让你觉得不舒服。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815254224,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27939},{"id":1779810878070,"text":"是我想得太简单了。","rawContent":"是我想得太简单了。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815257238,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27940},{"id":1779810878071,"text":"你要是不喜欢，我以后再也不叫了。","rawContent":"你要是不喜欢，我以后再也不叫了。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815261512,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27941},{"id":1779810878072,"text":"真的。","rawContent":"真的。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815262993,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27942},{"id":1779810878073,"text":"别生气了，好不好？","rawContent":"别生气了，好不好？","isHtml":false,"sticker":null,"sender":"them","time":"上午01:07","timestamp":1779815265528,"roundId":"round_1779815227332_uuy8qjq24","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27943},{"id":1779810878074,"text":"你晚饭就没怎么吃，现在又饿着肚子生气，晚上怎么睡得着。","rawContent":"你晚饭就没怎么吃，现在又饿着肚子生气，晚上怎么睡得着。",