isHtml":false,"sticker":null,"sender":"them","time":"上午01:10","timestamp":1779815415749,"roundId":"round_1779815350927_mdgcejq92","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27958},{"id":1779810878089,"text":"以后就算你再怎么骂我，我也不说那种话了。","rawContent":"以后就算你再怎么骂我，我也不说那种话了。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:10","timestamp":1779815419321,"roundId":"round_1779815350927_mdgcejq92","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27959},{"id":1779810878090,"text":"我不站门外，我就赖在床边，你赶我我也不走。","rawContent":"我不站门外，我就赖在床边，你赶我我也不走。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:10","timestamp":1779815422876,"roundId":"round_1779815350927_mdgcejq92","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27960},{"id":1779810878091,"text":"我错了。","rawContent":"我错了。","isHtml":false,"sticker":null,"sender":"them","time":"上午01:10","timestamp":1779815424725,"roundId":"round_1779815350927_mdgcejq92","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27961},{"id":1779810878092,"text":"不气了行不行？","rawContent":"不气了行不行？","isHtml":false,"sticker":null,"sender":"them","time":"上午01:10","timestamp":1779815426804,"roundId":"round_1779815350927_mdgcejq92","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":27962},{"id":1779810878093,"text":"你看我都白白挨骂了，是不是该给点补偿？","rawContent":"你看我都白白挨骂了，是不是该给点补偿？","isHtml":false,"sticker":null,"sender":"them","time":"上午01:10","timestamp":1779815430719,"roundId":"round_1779815350927_mdgcejq92","generatedMode":false,"translation":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d