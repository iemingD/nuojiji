[{"id":1777994830312,"text":"哪有你替我病这种","sender":"me","time":"上午01:22","timestamp":1778001771888,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16040},{"id":1777994830313,"text":"只有我们一起病！","sender":"me","time":"上午01:22","timestamp":1778001775898,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16041},{"id":1777994830314,"text":"我鼻子塞塞的","sender":"me","time":"上午01:23","timestamp":1778001783313,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16042},{"id":1777994830315,"text":"我想听你给我讲故事","sender":"me","time":"上午01:23","timestamp":1778001790122,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16043},{"id":1777994830316,"text":"就你之前那些","sender":"me","time":"上午01:23","timestamp":1778001795514,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16044},{"id":1777994830317,"sender":"them","text":"厉承修低低地笑出了声，胸腔的震动隔着薄薄的衣料传过来。他调整了一下姿势，让你靠得稍微高一点，好让呼吸顺畅些。","timestamp":1778001874678,"tempo":"N","type":"state","rawContent":"厉承修低低地笑出了声，胸腔的震动隔着薄薄的衣料传过来。他调整了一下姿势，让你靠得稍微高一点，好让呼吸顺畅些。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16045},{"id":1777994830318,"sender":"them","text":"好，一起病。只要你不嫌弃，传染给我多少次都行。","timestamp":1778001875380,"tempo":"N","rawContent":"好，一起病。只要你不嫌弃，传染给我多少次都行。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16046},{"id":1777994830319,"sender":"them","text":"他伸出骨节分明的手指，指腹轻轻按揉着你鼻翼两侧的穴位，动作极尽温柔，试图帮你缓解鼻塞。","timestamp":1778001876080,"tempo":"N","type":"state","rawContent":"他伸出骨节分明的手指，指腹轻轻按揉着你鼻翼两侧的穴位，动作极尽温柔，试图帮你缓解鼻塞。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16047},{"id":1777994830320,"sender":"them","text":"这样按一下会不会好受点？","timestamp":1778001876781,"tempo":"S","rawContent":"这样按一下会不会好受点？","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16048},{"id":1777994830321,"sender":"them","text":"想听故事……那我再给你讲个沈夜白的糗事。","timestamp":1778001878281,"tempo":"N","rawContent":"想听故事……那我再给你讲个沈夜白的糗事。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16049},{"id":1777994830322,"sender":"them","text":"大四毕业那年，沈夜白非要拉着我们去山里露营，说要体验什么‘荒野求生’。","timestamp":1778001878982,"tempo":"N","rawContent":"大四毕业那年，沈夜白非要拉着我们去山里露营，说要体验什么‘荒野求生’。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16050},{"id":1777994830323,"sender":"them","text":"结果到了地方，他死活不看说明书，非要自己搭帐篷。我和季凉川懒得理他，就坐在旁边看他折腾了两个小时。","timestamp":1778001879683,"tempo":"N","rawContent":"结果到了地方，他死活不看说明书，非要自己搭帐篷。我和季凉川懒得理他，就坐在旁边看他折腾了两个小时。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16051},{"id":1777994830324,"sender":"them","text":"厉承修的声音放得很轻，语速也慢了下来，像是在哄小孩睡觉，带着一丝慵懒的笑意。","timestamp":1778001880384,"tempo":"N","type":"state","rawContent":"厉承修的声音放得很轻，语速也慢了下来，像是在哄小孩睡觉，带着一丝慵懒的笑意。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16052},{"id":1777994830325,"sender":"them","text":"到了半夜，山里刮大风。那个帐篷直接塌了，把我和沈夜白死死压在里面。","timestamp":1778001881084,"tempo":"S","rawContent":"到了半夜，山里刮大风。那个帐篷直接塌了，把我和沈夜白死死压在里面。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16053},{"id":1777994830326,"sender":"them","text":"季凉川那个没良心的，戴着降噪耳机睡得死沉，怎么踹都不醒。","timestamp":1778001882585,"tempo":"N","rawContent":"季凉川那个没良心的，戴着降噪耳机睡得死沉，怎么踹都不醒。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16054},{"id":1777994830327,"sender":"them","text":"最后你猜怎么着？","timestamp":1778001883286,"tempo":"S","rawContent":"最后你猜怎么着？","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16055},{"id":1777994830328,"sender":"them","text":"还是宋远舟大半夜从山下的酒店开着车上来，打着手电筒，面无表情地把我们从一堆破布里挖出来的。","timestamp":1778001884787,"tempo":"N","rawContent":"还是宋远舟大半夜从山下的酒店开着车上来，打着手电筒，面无表情地把我们从一堆破布里挖出来的。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16056},{"id":1777994830329,"sender":"them","text":"他当时看着我们的眼神，就像在看三个智障。从那以后，宋远舟再也没参加过任何需要过夜的户外活动。","timestamp":1778001885487,"tempo":"N","rawContent":"他当时看着我们的眼神，就像在看三个智障。从那以后，宋远舟再也没参加过任何需要过夜的户外活动。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16057},{"id":1777994830330,"sender":"them","text":"他低头亲了亲你的发顶，手上的按摩动作没停，声音越来越轻柔。","timestamp":1778001886188,"tempo":"N","type":"state","rawContent":"他低头亲了亲你的发顶，手上的按摩动作没停，声音越来越轻柔。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16058},{"id":1777994830331,"sender":"them","text":"闭上眼睛，我慢慢讲给你听。老公一直在这儿陪你。","timestamp":1778001886889,"tempo":"S","rawContent":"闭上眼睛，我慢慢讲给你听。老公一直在这儿陪你。","roundId":"round_1778001795922_otmuuhlvo","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16059},{"id":1777994830332,"text":"还有呢","sender":"me","time":"上午01:25","timestamp":1778001950655,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16060},{"id":1777994830333,"text":"你们大学好有趣","sender":"me","time":"上午01:25","timestamp":1778001957595,"replyTo":null,"rawContent":"你们大学好有趣","isHtml":false,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16061},{"id":1777994830334,"text":"那你大学只有你们几个吗","sender":"me","time":"上午01:26","timestamp":1778001971294,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16062},{"id":1777994830335,"text":"你们都没有交过女朋友或者男朋友？","sender":"me","time":"上午01:26","timestamp":1778001980265,"replyTo":null,"userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16063},{"id":1777994830336,"sender":"them","text":"厉承修手上的动作没停，温热的指腹继续轻轻按揉着你的迎香穴，闻言低低地笑了一声。","timestamp":1778002050907,"tempo":"N","type":"state","rawContent":"厉承修手上的动作没停，温热的指腹继续轻轻按揉着你的迎香穴，闻言低低地笑了一声。","roundId":"round_1778001980707_nmyha2mh2","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16064},{"id":1777994830337,"sender":"them","text":"沈夜白那个浪子怎么可能没交过。他那时候在法学院可是风云人物，换女朋友比换季还快。不过都没长久过，他骨子里就是个怕受伤的胆小鬼，所以现在成了个坚定的恐婚分子。","timestamp":1778002051609,"tempo":"N","rawContent":"沈夜白那个浪子怎么可能没交过。他那时候在法学院可是风云人物，换女朋友比换季还快。不过都没长久过，他骨子里就是个怕受伤的胆小鬼，所以现在成了个坚定的恐婚分子。","roundId":"round_1778001980707_nmyha2mh2","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16065},{"id":1777994830338,"sender":"them","text":"季凉川嘛……追他的人不少，但他那张嘴太毒了，经常微笑着把人家小姑娘气哭。直到后来遇到他现在的老婆，同院的麻醉科医生，才算被彻底收服了。","timestamp":1778002052310,"tempo":"N","rawContent":"季凉川嘛……追他的人不少，但他那张嘴太毒了，经常微笑着把人家小姑娘气哭。直到后来遇到他现在的老婆，同院的麻醉科医生，才算被彻底收服了。","roundId":"round_1778001980707_nmyha2mh2","userId":"uid_1775571541656_v84y814wp","characterId":"d8a326fa-9988-447d-8d82-e4e5a4ece511","_id":16066},{"id":1777994830339,"sender":"them","text":"至于宋远舟……他大概是跟Excel表格结的婚。","timestamp":1778002053011,"tempo":"N","rawContent":"至于宋远舟……他大概是跟Excel表格结的婚。","roundId":"round_